rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if own(uid);
    }

    match /medicines/{docId} {
      allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }
    match /food_logs/{docId} {
      allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }
    match /steps_logs/{docId} {
      allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }
    match /family_members/{docId} {
      allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }
  }
}
